# URL base del backend usada por el frontend.
#
# Opción A (desarrollo con proxy de vite): déjalo como ruta relativa.
#   El navegador pide a /api y vite reenvía a VITE_PROXY_TARGET (mismo origen, sin CORS).
# Opción B (backend en otro dominio): pon la URL absoluta completa.
#   Ej: https://api.asigbo.org/api
VITE_SERVER_HOST=/api

# Solo se usa cuando VITE_SERVER_HOST es una ruta relativa.
# Backend al que el servidor de desarrollo reenvía las peticiones.
VITE_PROXY_TARGET=http://localhost:3000
